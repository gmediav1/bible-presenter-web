{
  "name": "bible-presenter-web",
  "version": "1.0.1",
  "description": "Bible presentation software with synchronized second-screen output.",
  "author": "Gwinn Media",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs",
    "desktop:start": "npm run build && electron .",
    "package": "npm run build && electron-builder --publish never",
    "package:win": "npm run build && electron-builder --win nsis --publish never",
    "package:win:dir": "npm run build && electron-builder --win dir --publish never"
  },
  "devDependencies": {
    "@netlify/functions": "^4.2.2",
    "electron": "^39.2.7",
    "electron-builder": "^26.15.3",
    "vite": "^7.1.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "build": {
    "appId": "de.gwinnmedia.biblepresenter",
    "productName": "Bible Presenter",
    "executableName": "Bible Presenter",
    "copyright": "Copyright © 2026 Gwinn Media",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!**/*.test.*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "Bible-Presenter-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Bible Presenter",
      "uninstallDisplayName": "Bible Presenter"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "gmediav1",
        "repo": "bible-presenter-web",
        "releaseType": "release"
      }
    ]
  }
}
